{
    "name": "omnipulse/trustpilot",
    "type": "library",
    "description": "Omnipulse's Trustpilot: a business unit's TrustScore and reviews, the links to its profile and to review it, replying and inviting customers with the business user's token; Trustpilot's 24-hour refresh declared.",
    "keywords": [
        "reviews",
        "trustpilot",
        "trustscore",
        "omnipulse"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnipulse-trustpilot",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/contracts": "^1.0@dev",
        "omnisense/omnipulse": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "replace": {
        "omnireview/trustpilot": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Omnipulse\\Trustpilot\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnipulse\\Trustpilot\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "omnisense": {
            "policy": "policy.json"
        }
    },
    "config": {
        "sort-packages": true
    }
}
